# Copy to .env and fill in after you deploy (see steps below).

# Live IRS app URL — required for "Open IRS" to work on the public internet.
# Example: https://intelligence-recon-system.onrender.com
VITE_IRS_PUBLIC_URL=

# Optional: hosted printer e-commerce demo URL.
# Example: https://printer-demo.netlify.app/html/index.html
VITE_PRINTER_PUBLIC_URL=
